# ==============================================================================
# ClearMind AI - Environment Configuration
# ==============================================================================

# Application Configuration
PORT=3000
NODE_ENV=development
APP_NAME=ClearMind AI

# AI Provider Configuration
# Supported providers: gemini | openai | groq | ollama | demo
# If no API key is provided, the application safely runs in a clearly labeled Demo mode.
AI_PROVIDER=gemini

# Google Gemini Configuration
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI Configuration (optional alternative)
# Get an API key at: https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq Configuration (optional alternative for fast open-source models)
# Get a free API key at: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Configuration (optional for fully local self-hosted models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Rate Limiting & Security
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Conversation Storage Strategy
# client = Stored in browser localStorage only (privacy-first, browser-specific)
# server = Stored on server filesystem under data/
STORAGE_STRATEGY=client
